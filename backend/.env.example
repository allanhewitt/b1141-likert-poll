# Local testing: point at the public Postgres URL.
# On Coolify: point at the internal Postgres URL instead (see README).
DATABASE_URL=postgres://postgres:PASSWORD@HOST:5432/b1141_likert_poll

PORT=4000

# Comma-separated list of allowed frontend origins, or * for all.
ALLOWED_ORIGINS=*

# true = also write each response to the `responses` table permanently.
# false = in-memory only, cleared on restart (pre-approval default).
PERSIST_RESPONSES=true
